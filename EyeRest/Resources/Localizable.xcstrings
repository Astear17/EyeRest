{
  "sourceLanguage" : "en",
  "strings" : {
    "%u more reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thêm %u nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%u more reminders" } } } },
    "%@ enabled" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ enabled" } } } },
    "%lld completed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã hoàn thành %lld" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld completed" } } } },
    "%lld minutes" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld minutes" } } } },
    "%lld seconds remaining" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Còn %lld giây" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld seconds remaining" } } } },
    "%lld activities across %lld days\n%@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld hoạt động trong %lld ngày\n%@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld activities across %lld days\n%@" } } } },
    "About" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giới thiệu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "About" } } } },
    "Appearance" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giao diện" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Appearance" } } } },
    "Backups include settings and activity history. Notification permission and scheduled alerts are never included." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao lưu gồm cài đặt và lịch sử hoạt động. Quyền thông báo và các thông báo đã lên lịch không bao giờ được đưa vào." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Backups include settings and activity history. Notification permission and scheduled alerts are never included." } } } },
    "Blinking" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chớp mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Blinking" } } } },
    "Cancel" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hủy" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } } } },
    "Check your posture and relax your shoulders." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kiểm tra tư thế ngồi và thả lỏng đôi vai." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Check your posture and relax your shoulders." } } } },
    "Countdown %@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đếm ngược %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Countdown %@" } } } },
    "Custom notification message" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nội dung thông báo tùy chỉnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom notification message" } } } },
    "Dark" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tối" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Dark" } } } },
    "Data" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dữ liệu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Data" } } } },
    "Data could not be updated" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể cập nhật dữ liệu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Data could not be updated" } } } },
    "Done" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xong" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } } } },
    "Each category schedules independently. Changes are saved on this device and update the notification queue." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mỗi loại nhắc nhở được lên lịch riêng. Thay đổi được lưu trên thiết bị này và cập nhật hàng đợi thông báo." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Each category schedules independently. Changes are saved on this device and update the notification queue." } } } },
    "Enable a reminder to begin" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật một nhắc nhở để bắt đầu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable a reminder to begin" } } } },
    "Enable notifications for EyeRest in iPhone Settings to receive reminders." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy bật thông báo cho EyeRest trong Cài đặt của iPhone để nhận nhắc nhở." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable notifications for EyeRest in iPhone Settings to receive reminders." } } } },
    "Enable quiet hours" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật giờ yên tĩnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable quiet hours" } } } },
    "Enable reminder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable reminder" } } } },
    "End" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kết thúc" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "End" } } } },
    "Every %lld min · %@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mỗi %lld phút · %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Every %lld min · %@" } } } },
    "Export backup" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xuất bản sao lưu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Export backup" } } } },
    "Eye relaxation" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thư giãn mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye relaxation" } } } },
    "Eye rest" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nghỉ mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye rest" } } } },
    "Eye rest now" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nghỉ mắt ngay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye rest now" } } } },
    "EyeRest works fully offline. No analytics, advertising, accounts, tracking, or external services." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "EyeRest hoạt động hoàn toàn ngoại tuyến. Không có phân tích, quảng cáo, tài khoản, theo dõi hay dịch vụ bên ngoài." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "EyeRest works fully offline. No analytics, advertising, accounts, tracking, or external services." } } } },
    "Hydration" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Uống nước" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hydration" } } } },
    "Interval: %lld minutes" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khoảng cách: %lld phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Interval: %lld minutes" } } } },
    "Interruption level" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mức độ gián đoạn" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Interruption level" } } } },
    "Import and replace settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhập và thay thế cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import and replace settings" } } } },
    "Import backup" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhập bản sao lưu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import backup" } } } },
    "Import this backup?" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhập bản sao lưu này?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import this backup?" } } } },
    "Light" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Sáng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Light" } } } },
    "Look at something about 20 feet (6 m) away." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nhìn vào vật cách xa khoảng 6 m." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Look at something about 20 feet (6 m) away." } } } },
    "Movement" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Vận động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Movement" } } } },
    "Next reminder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở tiếp theo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Next reminder" } } } },
    "Next scheduled" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lần nhắc tiếp theo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Next scheduled" } } } },
    "No activity dates" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không có ngày hoạt động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No activity dates" } } } },
    "Normal" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông thường" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } } } },
    "Notification message" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nội dung thông báo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notification message" } } } },
    "Notifications" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } } } },
    "Notifications are off" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo đang tắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off" } } } },
    "Notifications are off. EyeRest can't remind you until you turn them on." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo đang tắt. EyeRest không thể nhắc bạn cho đến khi bạn bật lại." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off. EyeRest can't remind you until you turn them on." } } } },
    "Notifications are scheduled as individual dates so quiet hours and time-zone changes can be respected." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo được lên lịch theo từng thời điểm cụ thể để tôn trọng giờ yên tĩnh và thay đổi múi giờ." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are scheduled as individual dates so quiet hours and time-zone changes can be respected." } } } },
    "Off" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } } } },
    "OK" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "OK" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } } } },
    "Open Settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở Cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } } } },
    "Open settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open settings" } } } },
    "Pause" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } } } },
    "Pause for 1 hour" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng 1 giờ" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause for 1 hour" } } } },
    "Pause for rest of today" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng đến hết hôm nay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause for rest of today" } } } },
    "Pause until I resume" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng đến khi tôi tiếp tục" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause until I resume" } } } },
    "Paused" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Paused" } } } },
    "Paused until %@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng đến %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Paused until %@" } } } },
    "Posture" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tư thế ngồi" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Posture" } } } },
    "Quiet" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Yên lặng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet" } } } },
    "Quiet delivers the alert without sound." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ Yên lặng hiển thị thông báo nhưng không phát âm thanh." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet delivers the alert without sound." } } } },
    "Quiet hours" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giờ yên tĩnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet hours" } } } },
    "Remember to blink naturally and relax your eyes." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nhớ chớp mắt tự nhiên và thư giãn đôi mắt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remember to blink naturally and relax your eyes." } } } },
    "Reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders" } } } },
    "Reminders are paused" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở đang tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders are paused" } } } },
    "Reminders are queued until %@. Open EyeRest to keep them going." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở đã được lên lịch đến %@. Hãy mở EyeRest để tiếp tục duy trì." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders are queued until %@. Open EyeRest to keep them going." } } } },
    "Request notification permission" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cấp quyền thông báo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Request notification permission" } } } },
    "Restore" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore" } } } },
    "Restore default intervals" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục khoảng cách mặc định" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default intervals" } } } },
    "Restore default reminders?" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục nhắc nhở mặc định?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default reminders?" } } } },
    "Rest complete" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn thành" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest complete" } } } },
    "Resume" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tiếp tục" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume" } } } },
    "Resume reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tiếp tục nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume reminders" } } } },
    "Schedule" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lịch hoạt động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Schedule" } } } },
    "Settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings" } } } },
    "Snooze 10 min" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Báo lại sau 10 phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snooze 10 min" } } } },
    "Snooze" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Báo lại" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snooze" } } } },
    "Snooze %lld min" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Báo lại sau %lld phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snooze %lld min" } } } },
    "Start" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bắt đầu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Start" } } } },
    "System" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Theo hệ thống" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "System" } } } },
    "Take a moment to drink some water." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng lại một chút để uống nước." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a moment to drink some water." } } } },
    "Take a short movement break." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nghỉ một lát để vận động nhẹ." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a short movement break." } } } },
    "Theme" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chủ đề" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Theme" } } } },
    "This restores each reminder's interval, message and on/off state. Quiet hours, theme and history are kept." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thao tác này khôi phục khoảng cách, nội dung và trạng thái bật/tắt của từng nhắc nhở. Giờ yên tĩnh, giao diện và lịch sử được giữ nguyên." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This restores each reminder's interval, message and on/off state. Quiet hours, theme and history are kept." } } } },
    "The backup could not be exported." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể xuất bản sao lưu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup could not be exported." } } } },
    "The backup could not be imported. Your data was not changed." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể nhập bản sao lưu. Dữ liệu của bạn không bị thay đổi." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup could not be imported. Your data was not changed." } } } },
    "The previous data could not be restored." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể khôi phục dữ liệu trước đó." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The previous data could not be restored." } } } },
    "This backup is damaged or has been changed." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao lưu này bị hỏng hoặc đã bị thay đổi." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This backup is damaged or has been changed." } } } },
    "This backup was created by a newer version of EyeRest." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao lưu này được tạo bởi phiên bản EyeRest mới hơn." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This backup was created by a newer version of EyeRest." } } } },
    "This file is not a valid EyeRest backup." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tệp này không phải là bản sao lưu EyeRest hợp lệ." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This file is not a valid EyeRest backup." } } } },
    "Time Sensitive" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhạy cảm về thời gian" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time Sensitive" } } } },
    "Time Sensitive isn't available for this install, so reminders arrive as normal notifications." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ Nhạy cảm về thời gian không khả dụng với bản cài đặt này, nên nhắc nhở sẽ đến dưới dạng thông báo thông thường." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time Sensitive isn't available for this install, so reminders arrive as normal notifications." } } } },
    "Time to rest your eyes. Look at something about 20 feet (6 m) away for 20 seconds." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đến lúc cho mắt nghỉ ngơi. Hãy nhìn vào vật cách xa khoảng 6 m trong 20 giây." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time to rest your eyes. Look at something about 20 feet (6 m) away for 20 seconds." } } } },
    "Today" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hôm nay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Today" } } } },
    "Undo last import" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn tác lần nhập gần nhất" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Undo last import" } } } },
    "Version" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phiên bản" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Version" } } } },
    "Work week" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tuần làm việc" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Work week" } } } },
    "Your reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở của bạn" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your reminders" } } } },
    "Your reminders are scheduled privately on this iPhone. EyeRest does not collect or send any data." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở được lên lịch riêng tư ngay trên iPhone này. EyeRest không thu thập hay gửi đi bất kỳ dữ liệu nào." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your reminders are scheduled privately on this iPhone. EyeRest does not collect or send any data." } } } },
    "Arms and wrists" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cánh tay và cổ tay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Arms and wrists" } } } },
    "Break complete" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn thành giờ nghỉ" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Break complete" } } } },
    "Close your eyes or gently cover them with your palms." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắm mắt hoặc nhẹ nhàng che mắt bằng lòng bàn tay." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Close your eyes or gently cover them with your palms." } } } },
    "Focus on something nearby, then something far away." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tập trung vào một vật ở gần, rồi một vật ở xa." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus on something nearby, then something far away." } } } },
    "Gently roll your neck and shoulders." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhẹ nhàng xoay cổ và vai." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Gently roll your neck and shoulders." } } } },
    "Haptics" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phản hồi xúc giác" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Haptics" } } } },
    "Look at something far away." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nhìn vào một vật ở xa." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Look at something far away." } } } },
    "Look far" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhìn xa" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Look far" } } } },
    "Look into the distance" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhìn ra xa" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Look into the distance" } } } },
    "Neck and shoulders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cổ và vai" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Neck and shoulders" } } } },
    "Place both feet flat and sit tall." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đặt hai bàn chân phẳng trên sàn và ngồi thẳng." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Place both feet flat and sit tall." } } } },
    "Posture check" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kiểm tra tư thế" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Posture check" } } } },
    "Release tension" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thả lỏng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Release tension" } } } },
    "Rest your eyes" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cho mắt nghỉ ngơi" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest your eyes" } } } },
    "Roll shoulders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xoay vai" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Roll shoulders" } } } },
    "Roll your shoulders back and down." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xoay vai ra sau và hạ xuống." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Roll your shoulders back and down." } } } },
    "Shift focus" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thay đổi tiêu điểm" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shift focus" } } } },
    "Sit down" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ngồi xuống" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sit down" } } } },
    "Sit down slowly when you are ready." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Từ từ ngồi xuống khi bạn đã sẵn sàng." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sit down slowly when you are ready." } } } },
    "Sit tall" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ngồi thẳng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sit tall" } } } },
    "Stand up" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đứng dậy" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand up" } } } },
    "Stand up and move" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đứng dậy và vận động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand up and move" } } } },
    "Stand up at a comfortable pace." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đứng dậy với nhịp độ thoải mái." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand up at a comfortable pace." } } } },
    "Start a break" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bắt đầu nghỉ" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Start a break" } } } },
    "Stop if anything hurts." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng lại nếu bạn thấy đau." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop if anything hurts." } } } },
    "Stretch your arms and wrists gently." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhẹ nhàng duỗi cánh tay và cổ tay." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stretch your arms and wrists gently." } } } },
    "Unclench your jaw and relax your hands." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thả lỏng hàm và thư giãn bàn tay." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Unclench your jaw and relax your hands." } } } },
    "Walk in place" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đi bộ tại chỗ" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Walk in place" } } } },
    "Walk in place at a comfortable pace." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đi bộ tại chỗ với nhịp độ thoải mái." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Walk in place at a comfortable pace." } } } },
    "%@: %lld completions" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%@: %lld lần hoàn thành" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: %lld completions" } } } },
    "%@ min" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%@ phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ min" } } } },
    "%lld days" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld ngày" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld days" } } } },
    "%lld min" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "%lld phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } } } },
