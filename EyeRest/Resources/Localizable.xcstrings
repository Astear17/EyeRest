    "%lld-day streak" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuỗi %lld ngày" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld-day streak" } } } },
    "Activity" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoạt động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Activity" } } } },
    "Best streak" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chuỗi tốt nhất" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Best streak" } } } },
    "Complete a break to begin your activity chart." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn thành một giờ nghỉ để bắt đầu biểu đồ hoạt động." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Complete a break to begin your activity chart." } } } },
    "Completed breaks will appear here." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các giờ nghỉ đã hoàn thành sẽ xuất hiện ở đây." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Completed breaks will appear here." } } } },
