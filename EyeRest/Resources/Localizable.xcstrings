    "Notifications are off" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo đang tắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off" } } } },
    "Notifications are off. EyeRest can't remind you until you turn them on." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo đang tắt. EyeRest không thể nhắc bạn cho đến khi bạn bật lại." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off. EyeRest can't remind you until you turn them on." } } } },
    "Notifications are scheduled as individual dates so quiet hours and time-zone changes can be respected." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông báo được lên lịch theo từng thời điểm cụ thể để tôn trọng giờ yên tĩnh và thay đổi múi giờ." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are scheduled as individual dates so quiet hours and time-zone changes can be respected." } } } },
    "Off" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } } } },
    "Open Settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở Cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } } } },
    "Open settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open settings" } } } },
    "Pause" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } } } },
    "Paused" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Paused" } } } },
    "Posture" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tư thế ngồi" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Posture" } } } },
    "Quiet" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Yên lặng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet" } } } },
    "Quiet delivers the alert without sound." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ Yên lặng hiển thị thông báo nhưng không phát âm thanh." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet delivers the alert without sound." } } } },
    "Quiet hours" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giờ yên tĩnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quiet hours" } } } },
    "Remember to blink naturally and relax your eyes." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nhớ chớp mắt tự nhiên và thư giãn đôi mắt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remember to blink naturally and relax your eyes." } } } },
    "Reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders" } } } },
    "Reminders are paused" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở đang tạm dừng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders are paused" } } } },
    "Reminders are queued until %@. Open EyeRest to keep them going." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở đã được lên lịch đến %@. Hãy mở EyeRest để tiếp tục duy trì." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders are queued until %@. Open EyeRest to keep them going." } } } },
    "Request notification permission" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cấp quyền thông báo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Request notification permission" } } } },
    "Restore" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore" } } } },
    "Restore default intervals" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục khoảng cách mặc định" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default intervals" } } } },
    "Restore default reminders?" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục nhắc nhở mặc định?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default reminders?" } } } },
    "Rest complete" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn thành" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest complete" } } } },
    "Resume" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tiếp tục" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume" } } } },
    "Settings" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cài đặt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings" } } } },
    "Snooze 10 min" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Báo lại sau 10 phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snooze 10 min" } } } },
    "Start" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bắt đầu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Start" } } } },
    "System" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Theo hệ thống" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "System" } } } },
    "Take a moment to drink some water." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng lại một chút để uống nước." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a moment to drink some water." } } } },
    "Take a short movement break." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nghỉ một lát để vận động nhẹ." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a short movement break." } } } },
    "Theme" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chủ đề" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Theme" } } } },
    "This restores each reminder's interval, message and on/off state. Quiet hours, theme and history are kept." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thao tác này khôi phục khoảng cách, nội dung và trạng thái bật/tắt của từng nhắc nhở. Giờ yên tĩnh, giao diện và lịch sử được giữ nguyên." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This restores each reminder's interval, message and on/off state. Quiet hours, theme and history are kept." } } } },
    "Time Sensitive" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhạy cảm về thời gian" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time Sensitive" } } } },
    "Time Sensitive isn't available for this install, so reminders arrive as normal notifications." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ Nhạy cảm về thời gian không khả dụng với bản cài đặt này, nên nhắc nhở sẽ đến dưới dạng thông báo thông thường." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time Sensitive isn't available for this install, so reminders arrive as normal notifications." } } } },
    "Time to rest your eyes. Look at something about 20 feet (6 m) away for 20 seconds." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đến lúc cho mắt nghỉ ngơi. Hãy nhìn vào vật cách xa khoảng 6 m trong 20 giây." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Time to rest your eyes. Look at something about 20 feet (6 m) away for 20 seconds." } } } },
    "Today" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hôm nay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Today" } } } },
    "Version" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phiên bản" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Version" } } } },
    "Your reminders" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở của bạn" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your reminders" } } } },
    "Your reminders are scheduled privately on this iPhone. EyeRest does not collect or send any data." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở được lên lịch riêng tư ngay trên iPhone này. EyeRest không thu thập hay gửi đi bất kỳ dữ liệu nào." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your reminders are scheduled privately on this iPhone. EyeRest does not collect or send any data." } } } }
  },
  "version" : "1.0"
}
