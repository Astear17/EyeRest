    "Check your posture and relax your shoulders." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kiểm tra tư thế ngồi và thả lỏng đôi vai." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Check your posture and relax your shoulders." } } } },
    "Countdown %@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đếm ngược %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Countdown %@" } } } },
    "Custom notification message" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nội dung thông báo tùy chỉnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom notification message" } } } },
    "Dark" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tối" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Dark" } } } },
    "Done" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xong" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } } } },
    "Each category schedules independently. Changes are saved on this device and update the notification queue." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mỗi loại nhắc nhở được lên lịch riêng. Thay đổi được lưu trên thiết bị này và cập nhật hàng đợi thông báo." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Each category schedules independently. Changes are saved on this device and update the notification queue." } } } },
    "Enable a reminder to begin" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật một nhắc nhở để bắt đầu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable a reminder to begin" } } } },
    "Enable notifications for EyeRest in iPhone Settings to receive reminders." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy bật thông báo cho EyeRest trong Cài đặt của iPhone để nhận nhắc nhở." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable notifications for EyeRest in iPhone Settings to receive reminders." } } } },
    "Enable quiet hours" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật giờ yên tĩnh" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable quiet hours" } } } },
    "Enable reminder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật nhắc nhở" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable reminder" } } } },
    "End" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kết thúc" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "End" } } } },
    "Every %lld min · %@" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mỗi %lld phút · %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Every %lld min · %@" } } } },
    "Eye relaxation" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thư giãn mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye relaxation" } } } },
    "Eye rest" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nghỉ mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye rest" } } } },
    "Eye rest now" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nghỉ mắt ngay" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye rest now" } } } },
    "EyeRest works fully offline. No analytics, advertising, accounts, tracking, or external services." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "EyeRest hoạt động hoàn toàn ngoại tuyến. Không có phân tích, quảng cáo, tài khoản, theo dõi hay dịch vụ bên ngoài." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "EyeRest works fully offline. No analytics, advertising, accounts, tracking, or external services." } } } },
    "Hydration" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Uống nước" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hydration" } } } },
    "Interval: %lld minutes" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khoảng cách: %lld phút" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Interval: %lld minutes" } } } },
    "Interruption level" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mức độ gián đoạn" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Interruption level" } } } },
    "Light" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Sáng" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Light" } } } },
    "Look at something about 20 feet (6 m) away." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy nhìn vào vật cách xa khoảng 6 m." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Look at something about 20 feet (6 m) away." } } } },
    "Movement" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Vận động" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Movement" } } } },
    "Next reminder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhắc nhở tiếp theo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Next reminder" } } } },
    "Next scheduled" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lần nhắc tiếp theo" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Next scheduled" } } } },
