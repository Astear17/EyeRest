{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ enabled" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bật %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ enabled" } } } },
    "%lld completed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã hoàn thành %lld" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld completed" } } } },
    "%lld seconds remaining" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Còn %lld giây" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld seconds remaining" } } } },
    "About" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giới thiệu" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "About" } } } },
    "Appearance" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giao diện" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Appearance" } } } },
    "Blinking" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chớp mắt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Blinking" } } } },
